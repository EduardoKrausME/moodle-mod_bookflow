{{!
    @template mod_bookflow/table_of_contents

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

<ol class="bookflow-toc-list">
    {{#toc}}
        <li class="{{#subchapter}}bookflow-subchapter{{/subchapter}} {{#current}}is-current{{/current}}">
            <a href="{{{url}}}" {{#current}}aria-current="page"{{/current}}>
                {{#number}}<span class="bookflow-toc-number">{{number}}</span>{{/number}}
                <span>{{title}}</span>
                {{#required}}<span class="badge text-bg-warning">{{#str}}required, mod_bookflow{{/str}}</span>{{/required}}
                {{#completed}}<span class="bookflow-status-complete">{{#str}}completed, mod_bookflow{{/str}}</span>{{/completed}}
                {{#hidden}}<span class="badge text-bg-secondary">{{#str}}hidden, mod_bookflow{{/str}}</span>{{/hidden}}
            </a>
            {{#hascontents}}
                <ol class="bookflow-toc-contents">
                    {{#contents}}
                        <li><a href="{{{url}}}"><span>{{title}}</span><small>{{type}}</small></a></li>
                    {{/contents}}
                </ol>
            {{/hascontents}}
        </li>
    {{/toc}}
</ol>
