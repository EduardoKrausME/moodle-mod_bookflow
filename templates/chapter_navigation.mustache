<nav class="flexbook-chapter-navigation" aria-label="{{#str}}chapternavigation, mod_flexbook{{/str}}">
    {{#hasprevious}}<a class="btn btn-outline-primary" href="{{{previousurl}}}">{{#str}}previouschapter, mod_flexbook{{/str}}</a>{{/hasprevious}}
