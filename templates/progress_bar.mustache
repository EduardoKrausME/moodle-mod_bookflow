{{!
    @template mod_bookflow/progress_bar

    Example context (json):
    {
        *Example context (json):*
    }
}}

<div class="bookflow-progress" data-region="progress" aria-label="{{#str}}progress, mod_bookflow{{/str}}">
    <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progressrounded}}">
        <div class="progress-bar" style="width: {{progressrounded}}%"></div>
    </div>
    <span data-region="progress-label">{{progressrounded}}%</span>
</div>
