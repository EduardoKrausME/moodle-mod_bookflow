{{!
    @template mod_flexbook/chapter

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

<div class="flexbook-reader" data-flexbook-id="{{flexbookid}}" data-chapter-id="{{chapterid}}">
    <aside class="flexbook-sidebar" aria-label="{{#str}}tableofcontents, mod_flexbook{{/str}}">
        <a class="btn btn-link px-0" href="{{{overviewurl}}}">{{#str}}backtooverview, mod_flexbook{{/str}}</a>
        {{> mod_flexbook/table_of_contents}}
    </aside>
    <main class="flexbook-chapter">
        <div class="flexbook-reader-progress">
            {{> mod_flexbook/progress_bar}}
        </div>
        <header>
            <h2>{{title}}</h2>
            {{#description}}<div class="flexbook-chapter-description">{{{description}}}</div>{{/description}}
            {{{chaptertools}}}
        </header>

        <div class="flexbook-content-list" data-region="content-list">
            {{#contents}}
                <section id="flexbook-content-{{id}}"
                         class="flexbook-content flexbook-content-{{type}} {{#hidden}}is-hidden{{/hidden}}"
                         data-content-id="{{id}}"
                         data-content-type="{{type}}"
                         data-track-progress="{{#tracked}}1{{/tracked}}{{^tracked}}0{{/tracked}}"
                         data-completion-type="{{completiontype}}"
                         data-completion-value="{{completionvalue}}"
                         tabindex="-1">
                    {{{html}}}
                    {{{toolshtml}}}
                    {{#editing}}
                        <nav class="flexbook-content-actions" aria-label="{{#str}}contentactions, mod_flexbook{{/str}}">
                            <a href="{{{editurl}}}">{{#str}}edit{{/str}}</a>
                            <a href="{{{duplicateurl}}}">{{#str}}duplicate, mod_flexbook{{/str}}</a>
                            <a href="{{{upurl}}}">{{#str}}moveup{{/str}}</a>
                            <a href="{{{downurl}}}">{{#str}}movedown{{/str}}</a>
                            <a href="{{{hideurl}}}">{{#str}}showhide, mod_flexbook{{/str}}</a>
                            <a href="{{{deleteurl}}}">{{#str}}delete{{/str}}</a>
                        </nav>
                    {{/editing}}
                </section>
            {{/contents}}
            {{^hascontents}}<div class="alert alert-info">{{#str}}nocontents, mod_flexbook{{/str}}</div>{{/hascontents}}
        </div>

        {{#editing}}
            {{#hasaddcontenttypes}}
                <button class="btn btn-primary"
                        type="button"
                        data-toggle="modal"
                        data-target="#flexbook-add-content-modal-{{chapterid}}">
                    {{#str}}addcontent, mod_flexbook{{/str}}
                </button>

                <div class="modal fade"
                     id="flexbook-add-content-modal-{{chapterid}}"
                     tabindex="-1"
                     role="dialog"
                     aria-labelledby="flexbook-add-content-title-{{chapterid}}"
                     aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="flexbook-add-content-title-{{chapterid}}">
                                    {{#str}}selectcontenttype, mod_flexbook{{/str}}
                                </h5>
                                <button type="button"
                                        class="close"
                                        data-dismiss="modal"
                                        aria-label="{{#str}}closebuttontitle{{/str}}">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted">{{#str}}selectcontenttypedescription, mod_flexbook{{/str}}</p>
                                <div class="list-group">
                                    {{#addcontenttypes}}
                                        <a class="list-group-item list-group-item-action"
                                           href="{{{url}}}">
                                            {{name}}
                                        </a>
                                    {{/addcontenttypes}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {{/hasaddcontenttypes}}
        {{/editing}}
        {{> mod_flexbook/chapter_navigation}}
    </main>
</div>
