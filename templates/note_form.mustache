{{!
    @template mod_flexbook/note_form

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

<form data-region="flexbook-note-form">
    <input type="hidden" name="chapterid" value="{{chapterid}}">
    <input type="hidden" name="contentid" value="{{contentid}}">
    <label for="flexbook-note-{{contentid}}">{{#str}}privatenote, mod_flexbook{{/str}}</label>
    <textarea id="flexbook-note-{{contentid}}" class="form-control" name="note" rows="4" required></textarea>
    <button class="btn btn-primary mt-2" type="submit">{{#str}}savenote, mod_flexbook{{/str}}</button>
</form>
