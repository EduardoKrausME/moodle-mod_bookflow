<div class="table-responsive mt-4">
    <table class="table">
        <thead><tr><th>{{#str}}chapter, mod_flexbook{{/str}}</th><th>{{#str}}required, mod_flexbook{{/str}}</th><th>{{#str}}hidden, mod_flexbook{{/str}}</th><th>{{#str}}actions{{/str}}</th></tr></thead>
        <tbody>
        {{#chapters}}
            <tr>
                <td><a href="{{{viewurl}}}">{{title}}</a></td>
                <td>{{required}}</td>
                <td>{{hidden}}</td>
                <td><a href="{{{editurl}}}">{{#str}}edit{{/str}}</a> · <a href="{{{deleteurl}}}">{{#str}}delete{{/str}}</a></td>
            </tr>
        {{/chapters}}
        </tbody>
    </table>
</div>
