{{!
    @template mod_flexbook/activity_overview

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

<div class="flexbook-overview" data-flexbook-id="{{flexbookid}}">
    <header class="flexbook-hero">
        <div class="flexbook-cover" aria-hidden="true">
            {{#hascover}}<img src="{{{coverurl}}}" alt="">{{/hascover}}
            {{^hascover}}<span class="flexbook-cover-icon">F</span>{{/hascover}}
        </div>
        <div class="flexbook-hero-content">
            <h2>{{name}}</h2>
            <div class="flexbook-intro">{{{intro}}}</div>
            <div class="flexbook-stats" aria-label="{{#str}}overviewstats, mod_flexbook{{/str}}">
                <span>{{chaptercountlabel}}</span>
                <span>{{estimatedtime}} {{#str}}ofstudy, mod_flexbook{{/str}}</span>
                <span>{{progressrounded}}% {{#str}}completed, mod_flexbook{{/str}}</span>
                <span>{{chapteraccesslabel}}</span>
            </div>
            {{> mod_flexbook/progress_bar}}
            {{#hascontinue}}
                {{> mod_flexbook/continue_reading}}
            {{/hascontinue}}
            {{{booktools}}}
        </div>
    </header>

    <nav class="flexbook-tools" aria-label="{{#str}}flexbooktools, mod_flexbook{{/str}}">
        {{#enablebookmarks}}<a class="btn btn-outline-secondary" href="{{{bookmarksurl}}}">{{#str}}mybookmarks, mod_flexbook{{/str}}</a>{{/enablebookmarks}}
        {{#enablenotes}}<a class="btn btn-outline-secondary" href="{{{notesurl}}}">{{#str}}mynotes, mod_flexbook{{/str}}</a>{{/enablenotes}}
        {{#canreport}}<a class="btn btn-outline-secondary" href="{{{reporturl}}}">{{#str}}reports, mod_flexbook{{/str}}</a>{{/canreport}}
        {{#canmanage}}<a class="btn btn-primary" href="{{{manageurl}}}">{{#str}}managechapters, mod_flexbook{{/str}}</a>{{/canmanage}}
    </nav>

    {{#enablesearch}}
        <form class="flexbook-search" data-region="flexbook-search">
            <label for="flexbook-search-input">{{#str}}searchinside, mod_flexbook{{/str}}</label>
            <div class="input-group">
                <input id="flexbook-search-input" class="form-control" type="search" minlength="2">
                <button class="btn btn-primary" type="submit">{{#str}}search{{/str}}</button>
            </div>
            <div data-region="search-results" aria-live="polite"></div>
        </form>
    {{/enablesearch}}

    <section class="flexbook-overview-toc" aria-labelledby="flexbook-toc-title">
        <h3 id="flexbook-toc-title">{{#str}}tableofcontents, mod_flexbook{{/str}}</h3>
        {{> mod_flexbook/table_of_contents}}
    </section>
</div>
