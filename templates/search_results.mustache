<div class="flexbook-search-results">
    {{#results}}
        <article>
            <h4><a href="{{{url}}}">{{chapter}}</a></h4>
            <p>{{excerpt}}</p>
            <span class="badge text-bg-light">{{type}}</span>
        </article>
    {{/results}}
    {{^results}}<p>{{#str}}noresults{{/str}}</p>{{/results}}
</div>
