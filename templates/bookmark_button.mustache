{{!
    @template mod_bookflow/bookmark_button

    Example context (json):
    {
        *Example context (json):*
    }
}}

<button class="btn btn-sm btn-outline-secondary"
        type="button"
        data-action="bookflow-bookmark"
        data-item-type="{{itemtype}}"
        data-chapter-id="{{chapterid}}"
        data-content-id="{{contentid}}"
        data-bookmark-id="{{bookmarkid}}"
        aria-pressed="{{#bookmarked}}true{{/bookmarked}}{{^bookmarked}}false{{/bookmarked}}">
    {{#bookmarked}}{{#str}}removebookmark, mod_bookflow{{/str}}{{/bookmarked}}
    {{^bookmarked}}{{#str}}addbookmark, mod_bookflow{{/str}}{{/bookmarked}}
</button>
