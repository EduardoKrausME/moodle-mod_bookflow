{{!
    @template flexbookcontent_video/video

    Example context (json):
    {
        "id": 42,
        "title": "Introduction",
        "source": "https://example.com/video.mp4",
        "nativevideo": true,
        "embeddedvideo": false,
        "embedhtml": "",
        "captionsurl": "",
        "data3": "Video transcript"
    }
}}

<div class="flexbook-video">
    {{#title}}<h3>{{title}}</h3>{{/title}}

    {{#nativevideo}}
        <video class="flexbook-video-player"
               controls
               playsinline
               preload="metadata"
               data-flexbook-media="{{id}}">
            <source src="{{{source}}}">
            {{#captionsurl}}
                <track kind="captions" src="{{{captionsurl}}}">
            {{/captionsurl}}
            {{#str}}videonotsupported, mod_flexbook{{/str}}
        </video>
    {{/nativevideo}}

    {{#embeddedvideo}}
        <div class="flexbook-video-embed" data-flexbook-media-embed="{{id}}">
            {{{embedhtml}}}
        </div>
    {{/embeddedvideo}}

    {{#data3}}
        <details class="flexbook-video-transcript">
            <summary>{{#str}}transcript, mod_flexbook{{/str}}</summary>
            <p>{{data3}}</p>
        </details>
    {{/data3}}
</div>
