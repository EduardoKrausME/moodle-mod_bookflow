{{!
    @template flexbookcontent_tabs/tabs

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

{{#title}}<h3>{{title}}</h3>{{/title}}
<div class="flexbook-tabs" data-flexbook-interactive="{{id}}">
    <div role="tablist">
        {{#items}}<button class="btn btn-outline-primary {{#first}}active{{/first}}" role="tab" data-item-index="{{index}}" aria-selected="{{#first}}true{{/first}}{{^first}}false{{/first}}">{{title}}</button>{{/items}}
    </div>
    {{#items}}<div role="tabpanel" class="{{^first}}d-none{{/first}}" data-panel-index="{{index}}">{{{content}}}</div>{{/items}}
</div>
