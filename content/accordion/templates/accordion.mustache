{{!
    @template bookflowcontent_accordion/accordion

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

{{#title}}<h3>{{title}}</h3>{{/title}}
<div class="accordion" data-bookflow-interactive="{{id}}">
    {{#items}}
        <div class="accordion-item">
            <h4 class="accordion-header">
                <button class="accordion-button collapsed" type="button" aria-expanded="false" data-item-index="{{index}}">{{title}}</button>
            </h4>
            <div class="accordion-collapse collapse"><div class="accordion-body">{{{content}}}</div></div>
        </div>
    {{/items}}
</div>
